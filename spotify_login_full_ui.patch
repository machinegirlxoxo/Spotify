+import 'package:flutter/material.dart';
+import 'package:get/get.dart';
+
+import '../screens/Library/library_controller.dart';
+import 'spotify_style.dart';
+
+/// Spotify-style top of the home screen: filter chips and a 2-column
+/// "quick access" grid made from the user's library.
+class SpotifyHomeHeader extends StatelessWidget {
+  const SpotifyHomeHeader({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return Padding(
+      padding: const EdgeInsets.only(right: 16, bottom: 12),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          SingleChildScrollView(
+            scrollDirection: Axis.horizontal,
+            child: Row(children: [
+              const Padding(
+                  padding: EdgeInsets.only(right: 12), child: SpAvatar(size: 36)),
+              const SpChip('All', selected: true),
+              const SpChip('Music'),
+              const SpChip('Podcasts'),
+              const SpChip('Audiobooks'),
+            ]),
+          ),
+          const SizedBox(height: 16),
+          Obx(() {
+            // Rebuild when any library list changes.
+            Get.find<LibraryPlaylistsController>().libraryPlaylists.length;
+            Get.find<LibraryAlbumsController>().libraryAlbums.length;
+            Get.find<LibraryArtistsController>().libraryArtists.length;
+            final entries = buildLibraryEntries()
+                .take(8)
+                .toList();
+            if (entries.isEmpty) return const SizedBox.shrink();
+            return GridView.builder(
+              shrinkWrap: true,
+              physics: const NeverScrollableScrollPhysics(),
+              gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
+                  crossAxisCount: 2,
+                  mainAxisSpacing: 8,
+                  crossAxisSpacing: 8,
+                  mainAxisExtent: 56),
+              itemCount: entries.length,
+              itemBuilder: (context, i) {
+                final e = entries[i];
+                return InkWell(
+                  onTap: e.open,
+                  child: Container(
+                    decoration: BoxDecoration(
+                        color: spSurface,
+                        borderRadius: BorderRadius.circular(6)),
+                    clipBehavior: Clip.antiAlias,
+                    child: Row(children: [
+                      e.thumb(56),
+                      const SizedBox(width: 10),
+                      Expanded(
+                        child: Text(e.title,
+                            maxLines: 2,
+                            overflow: TextOverflow.ellipsis,
+                            style: const TextStyle(
+                                fontSize: 13, fontWeight: FontWeight.w700)),
+                      ),
+                      const SizedBox(width: 6),
+                    ]),
+                  ),
+                );
+              },
+            );
+          }),
+        ],
+      ),
+    );
+  }
+}
