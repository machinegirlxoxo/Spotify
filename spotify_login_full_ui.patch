+import 'package:audio_service/audio_service.dart';
+import 'package:cached_network_image/cached_network_image.dart';
+import 'package:flutter/material.dart';
+
+import '/models/thumbnail.dart';
+import 'spotify_style.dart';
+
+/// "Find on this page" search bar shown at the top of a playlist.
+/// Calls [onStart] on the first keystroke, [onSearch] on every change and
+/// [onClose] when the field is emptied again.
+class SpFindOnPage extends StatefulWidget {
+  const SpFindOnPage(
+      {super.key,
+      required this.onStart,
+      required this.onSearch,
+      required this.onClose});
+  final VoidCallback onStart;
+  final ValueChanged<String> onSearch;
+  final VoidCallback onClose;
+
+  @override
+  State<SpFindOnPage> createState() => _SpFindOnPageState();
+}
+
+class _SpFindOnPageState extends State<SpFindOnPage> {
+  final _c = TextEditingController();
+  bool _started = false;
+
+  void _changed(String v) {
+    if (v.isEmpty) {
+      if (_started) widget.onClose();
+      _started = false;
+    } else {
+      if (!_started) widget.onStart();
+      _started = true;
+      widget.onSearch(v);
+    }
+  }
+
+  @override
+  void dispose() {
+    if (_started) Future.microtask(widget.onClose);
+    _c.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Padding(
+      padding: const EdgeInsets.fromLTRB(16, 4, 16, 16),
+      child: TextField(
+        controller: _c,
+        onChanged: _changed,
+        style: const TextStyle(fontWeight: FontWeight.w600),
+        decoration: InputDecoration(
+            isDense: true,
+            filled: true,
+            fillColor: Colors.white24,
+            contentPadding: const EdgeInsets.symmetric(vertical: 13),
+            hintText: 'Find on this page',
+            hintStyle: const TextStyle(
+                color: Colors.white70, fontWeight: FontWeight.w700),
+            prefixIcon: const Icon(Icons.search, size: 24),
+            border: OutlineInputBorder(
+                borderRadius: BorderRadius.circular(6),
+                borderSide: BorderSide.none)),
+      ),
+    );
+  }
+}
+
+String spTotalDuration(List<MediaItem> songs) {
+  final d = songs.fold<Duration>(
+      Duration.zero, (a, s) => a + (s.duration ?? Duration.zero));
+  final h = d.inHours;
+  final m = d.inMinutes % 60;
+  return h > 0 ? '${h}h ${m}min' : '${m}min';
+}
+
+/// Big centred cover, title, description, owner chip and "N songs • time".
+class SpPlaylistHeader extends StatelessWidget {
+  const SpPlaylistHeader(
+      {super.key,
+      required this.title,
+      required this.description,
+      required this.thumbnailUrl,
+      required this.owner,
+      required this.songs});
+  final String title;
+  final String? description;
+  final String thumbnailUrl;
+  final String owner;
+  final List<MediaItem> songs;
+
+  @override
+  Widget build(BuildContext context) {
+    final width = MediaQuery.of(context).size.width;
+    final cover = (width * 0.68).clamp(180.0, 320.0).toDouble();
+    final desc = (description ?? '').trim();
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        Center(
+          child: Container(
+            width: cover,
+            height: cover,
+            decoration: const BoxDecoration(boxShadow: [
+              BoxShadow(color: Colors.black45, blurRadius: 24, offset: Offset(0, 8))
+            ]),
+            child: CachedNetworkImage(
+              imageUrl: Thumbnail(thumbnailUrl).extraHigh,
+              fit: BoxFit.cover,
+              errorWidget: (_, __, ___) =>
+                  const ColoredBox(color: spSurface),
+            ),
+          ),
+        ),
+        Padding(
+          padding: const EdgeInsets.fromLTRB(16, 20, 16, 0),
+          child: Text(title,
+              maxLines: 2,
+              overflow: TextOverflow.ellipsis,
+              style: const TextStyle(fontSize: 26, fontWeight: FontWeight.w800)),
+        ),
+        if (desc.isNotEmpty)
+          Padding(
+            padding: const EdgeInsets.fromLTRB(16, 6, 16, 0),
+            child: Text(desc,
+                maxLines: 2,
+                overflow: TextOverflow.ellipsis,
+                style: const TextStyle(fontSize: 15, color: spGrey)),
+          ),
+        Padding(
+          padding: const EdgeInsets.fromLTRB(16, 12, 16, 0),
+          child: Row(children: [
+            const SpAvatar(size: 28, dot: false),
+            const SizedBox(width: 10),
+            Text(owner,
+                style:
+                    const TextStyle(fontSize: 15, fontWeight: FontWeight.w700)),
+          ]),
+        ),
+        Padding(
+          padding: const EdgeInsets.fromLTRB(16, 10, 16, 0),
+          child: Row(children: [
+            const Icon(Icons.public, size: 20, color: spGrey),
+            const SizedBox(width: 8),
+            Text('${songs.length} songs • ${spTotalDuration(songs)}',
+                style: const TextStyle(fontSize: 14, color: spGrey)),
+          ]),
+        ),
+        const SizedBox(height: 12),
+      ],
+    );
+  }
+}
+
+/// Spotify's pill buttons under the action row: Add / Edit / Sort / Name & details.
+class SpPillButton extends StatelessWidget {
+  const SpPillButton(this.icon, this.label, {super.key, this.onTap});
+  final IconData icon;
+  final String label;
+  final VoidCallback? onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    return GestureDetector(
+      onTap: onTap,
+      child: Container(
+        margin: const EdgeInsets.only(right: 10),
+        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 9),
+        decoration: BoxDecoration(
+            color: spSurface, borderRadius: BorderRadius.circular(30)),
+        child: Row(children: [
+          Icon(icon, size: 20),
+          const SizedBox(width: 8),
+          Text(label,
+              style:
+                  const TextStyle(fontSize: 14, fontWeight: FontWeight.w700)),
+        ]),
+      ),
+    );
+  }
+}
