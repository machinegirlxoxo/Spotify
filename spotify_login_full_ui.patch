+import 'package:flutter/material.dart';
+import 'package:flutter_inappwebview/flutter_inappwebview.dart';
+import 'package:get/get.dart';
+
+import '../../services/spotify_service.dart';
+
+/// Full-screen Spotify login page. Pops `true` once the `sp_dc` session
+/// cookie has been captured.
+class SpotifyWebLogin extends StatefulWidget {
+  const SpotifyWebLogin({super.key});
+
+  @override
+  State<SpotifyWebLogin> createState() => _SpotifyWebLoginState();
+}
+
+class _SpotifyWebLoginState extends State<SpotifyWebLogin> {
+  bool _done = false;
+
+  Future<void> _check(Uri? url) async {
+    if (_done || url == null || url.host != 'open.spotify.com') return;
+    final cookie = await CookieManager.instance().getCookie(
+        url: WebUri('https://open.spotify.com'), name: 'sp_dc');
+    final value = cookie?.value;
+    if (value != null && value.isNotEmpty) {
+      _done = true;
+      Get.find<SpotifyService>().onLoggedIn(value);
+      if (mounted) Navigator.of(context).pop(true);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      appBar: AppBar(title: const Text('Log in to Spotify')),
+      body: SafeArea(
+        child: InAppWebView(
+          initialUrlRequest: URLRequest(url: WebUri(SpotifyService.loginUrl)),
+          initialSettings: InAppWebViewSettings(
+            userAgent: SpotifyService.userAgent,
+            javaScriptEnabled: true,
+            domStorageEnabled: true,
+            thirdPartyCookiesEnabled: true,
+            javaScriptCanOpenWindowsAutomatically: true,
+          ),
+          onWebViewCreated: (_) async {
+            await CookieManager.instance().deleteAllCookies();
+          },
+          onLoadStop: (c, url) => _check(url),
+          onUpdateVisitedHistory: (c, url, _) => _check(url),
+        ),
+      ),
+    );
+  }
+}
