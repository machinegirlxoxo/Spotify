@@ -0,0 +1,116 @@
+import 'package:flutter/material.dart';
+import 'package:get/get.dart';
+
+import '../../services/spotify_service.dart';
+import 'spotify_web_login.dart';
+
+/// Asks the user to log in with Spotify, then imports their library.
+class SpotifyLoginDialog extends StatefulWidget {
+  const SpotifyLoginDialog({super.key});
+
+  static bool _shownThisSession = false;
+
+  /// Shown once on launch until the user logs in or taps "Skip".
+  static void showIfNeeded(BuildContext context) {
+    final sp = Get.find<SpotifyService>();
+    if (_shownThisSession || !sp.needsLogin) return;
+    _shownThisSession = true;
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (context.mounted) {
+        showDialog(
+            context: context,
+            barrierDismissible: false,
+            builder: (_) => const SpotifyLoginDialog());
+      }
+    });
+  }
+
+  @override
+  State<SpotifyLoginDialog> createState() => _SpotifyLoginDialogState();
+}
+
+class _SpotifyLoginDialogState extends State<SpotifyLoginDialog> {
+  final sp = Get.find<SpotifyService>();
+  String? error;
+  bool busy = false;
+
+  Future<void> _login() async {
+    setState(() {
+      busy = true;
+      error = null;
+    });
+    final ok = await Navigator.of(context).push<bool>(
+        MaterialPageRoute(builder: (_) => const SpotifyWebLogin()));
+    if (ok != true) {
+      if (mounted) setState(() => busy = false);
+      return;
+    }
+    final err = await sp.importLibrary();
+    if (!mounted) return;
+    if (err != null) {
+      setState(() {
+        busy = false;
+        error = err;
+      });
+    } else {
+      Navigator.of(context).pop();
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Dialog(
+      child: Padding(
+        padding: const EdgeInsets.all(24),
+        child: SingleChildScrollView(
+          child: Obx(() {
+            if (sp.isImporting.value) {
+              return Column(mainAxisSize: MainAxisSize.min, children: [
+                Text('Importing from Spotify',
+                    style: Theme.of(context).textTheme.titleLarge),
+                const SizedBox(height: 20),
+                LinearProgressIndicator(value: sp.progress.value),
+                const SizedBox(height: 12),
+                Text(sp.status.value,
+                    maxLines: 1, overflow: TextOverflow.ellipsis),
+                const SizedBox(height: 8),
+                Text('Matching every track to YouTube Music. This can take a '
+                    'few minutes the first time.',
+                    style: Theme.of(context).textTheme.bodySmall),
+              ]);
+            }
+            return Column(mainAxisSize: MainAxisSize.min, children: [
+              Text('Log in with Spotify',
+                  style: Theme.of(context).textTheme.titleLarge),
+              const SizedBox(height: 12),
+              Text('Your playlists, liked songs, albums and artists will be '
+                  'imported. Audio is still streamed from YouTube Music. A '
+                  'free Spotify account works.',
+                  style: Theme.of(context).textTheme.bodyMedium),
+              if (error != null)
+                Padding(
+                  padding: const EdgeInsets.only(top: 12),
+                  child: Text(error!,
+                      style: const TextStyle(color: Colors.redAccent)),
+                ),
+              const SizedBox(height: 16),
+              Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
+                TextButton(
+                    onPressed: busy
+                        ? null
+                        : () {
+                            sp.skip();
+                            Navigator.of(context).pop();
+                          },
+                    child: const Text('Skip')),
+                FilledButton(
+                    onPressed: busy ? null : _login,
+                    child: const Text('Log in')),
+              ]),
+            ]);
+          }),
+        ),
+      ),
+    );
+  }
+}
