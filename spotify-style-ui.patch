+        player.playPlayListSong(List<MediaItem>.from(widget.queue),
+            index < 0 ? 0 : index,
+            playfrom: PlaylingFrom(
+                name: "search".tr, type: PlaylingFromType.SELECTION));
+      },
+      leading: ImageWidget(size: 55, song: song),
+      title: Obx(() {
