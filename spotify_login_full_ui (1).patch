+
+const spGreen = Color(0xFF1ED760);
+const spSurface = Color(0xFF282828);
+const spGrey = Color(0xFFB3B3B3);
+const spBg = Color(0xFF121212);
+const spBlue = Color(0xFF3D91F4);
+
+/// Darkened, saturated version of [base] (the dynamic album colour) used for
+/// the player gradient, the mini player card and the lyrics preview card.
+Color spTint(Color? base, {double lightness = 0.28}) {
+  final hsl = HSLColor.fromColor(base ?? const Color(0xFF1E4D78));
+  return hsl
+      .withLightness(lightness)
+      .withSaturation(hsl.saturation.clamp(0.35, 0.85).toDouble())
+      .toColor();
+}
+
+/// Tint taken from the current album cover (see [AlbumColor]).
+Color spThemeTint({double lightness = 0.28}) {
+  return spTint(AlbumColor.instance.color.value, lightness: lightness);
+}
+
+/// Height of the bottom navigation bar (without the system inset).
+const double spNavHeight = 64;
+
+/// Height of the mini player card itself.
+const double spMiniHeight = 75;
+
+/// Panel min-height that leaves room for the mini player *and* the bottom
+/// navigation bar that sits underneath it.
+double spMiniPlayerMinHeight() =>
+    spMiniHeight + spNavHeight + Get.mediaQuery.viewPadding.bottom;
+
+/// Round profile picture with Spotify's little blue notification dot.
+/// Tapping it opens the settings tab (where the Spotify login lives).
+class SpAvatar extends StatelessWidget {
+  const SpAvatar({super.key, this.size = 36, this.dot = true});
+  final double size;
+  final bool dot;
+
+  @override
+  Widget build(BuildContext context) {
+    return GestureDetector(
+      onTap: () => Get.find<HomeScreenController>().onBottonBarTabSelected(3),
+      child: Stack(clipBehavior: Clip.none, children: [
+        CircleAvatar(
+            radius: size / 2,
+            backgroundColor: spSurface,
+            child: Icon(Icons.person, size: size * 0.55, color: Colors.white)),
+        if (dot)
+          Positioned(
+              right: -1,
+              top: -1,
+              child: Container(
+                  width: 10,
+                  height: 10,
+                  decoration: const BoxDecoration(
+                      color: spBlue, shape: BoxShape.circle))),
+      ]),
+    );
+  }
+}
+
+/// Purple-to-mint "Liked Songs" cover with a white heart.
+class SpLikedCover extends StatelessWidget {
+  const SpLikedCover(this.size, {super.key});
+  final double size;
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
+      width: size,
+      height: size,
+      decoration: const BoxDecoration(
+          gradient: LinearGradient(
+              begin: Alignment.topLeft,
+              end: Alignment.bottomRight,
+              colors: [Color(0xFF450AF5), Color(0xFF8E8EE5), Color(0xFFC4EFD9)])),
+      child: Icon(Icons.favorite, color: Colors.white, size: size * 0.45),
+    );
+  }
+}
+
+/// Spotify's green "saved" check (filled) / "add" ring (outlined).
+class SpSavedButton extends StatelessWidget {
+  const SpSavedButton({super.key, required this.saved, this.size = 28, this.onTap});
+  final bool saved;
+  final double size;
+  final VoidCallback? onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    return GestureDetector(
+      onTap: onTap,
+      behavior: HitTestBehavior.opaque,
+      child: Padding(
+        padding: const EdgeInsets.all(6),
+        child: saved
+            ? Container(
+                width: size,
+                height: size,
+                decoration:
+                    const BoxDecoration(color: spGreen, shape: BoxShape.circle),
+                child: Icon(Icons.check, color: Colors.black, size: size * 0.68))
+            : Icon(Icons.add_circle_outline, color: spGrey, size: size),
+      ),
+    );
+  }
+}
+
+/// Pill-shaped filter chip like Spotify's (Playlists / Albums / ...).
+class SpChip extends StatelessWidget {
+  const SpChip(this.label, {super.key, this.selected = false, this.onTap});
+  final String label;
+  final bool selected;
+  final VoidCallback? onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    return GestureDetector(
+      onTap: onTap,
+      child: Container(
+        margin: const EdgeInsets.only(right: 8),
+        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
+        decoration: BoxDecoration(
+            color: selected ? spGreen : spSurface,
+            borderRadius: BorderRadius.circular(30)),
+        child: Text(label,
+            style: TextStyle(
+                fontWeight: FontWeight.w600,
+                fontSize: 14,
+                color: selected ? Colors.black : Colors.white)),
+      ),
+    );
+  }
+}
+
+/// One entry of the unified library list.
+class LibEntry {
+  LibEntry(this.kind, this.title, this.subtitle, this.item);
+  final String kind; // playlist | album | artist
+  final String title;
+  final String subtitle;
+  final dynamic item;
+
+  void open() {
+    if (kind == 'album') {
+      final a = item as Album;
+      Get.toNamed(ScreenNavigationSetup.albumScreen,
+          id: ScreenNavigationSetup.id, arguments: (a, a.browseId));
+    } else if (kind == 'artist') {
+      Get.toNamed(ScreenNavigationSetup.artistScreen,
+          id: ScreenNavigationSetup.id, arguments: [false, item as Artist]);
+    } else {
+      final p = item as Playlist;
+      Get.toNamed(ScreenNavigationSetup.playlistScreen,
+          id: ScreenNavigationSetup.id, arguments: [p, p.playlistId]);
+    }
+  }
+
+  Widget thumb(double size) {
+    if (kind == 'playlist' && (item as Playlist).playlistId == 'LIBSP_liked') {
+      return ClipRRect(
+          borderRadius: BorderRadius.circular(4), child: SpLikedCover(size));
+    }
+    final w = kind == 'artist'
+        ? ImageWidget(size: size, artist: item as Artist)
+        : kind == 'album'
+            ? ImageWidget(size: size, album: item as Album)
+            : ImageWidget(size: size, playlist: item as Playlist);
+    return kind == 'artist'
+        ? ClipOval(child: SizedBox(width: size, height: size, child: w))
+        : ClipRRect(
+            borderRadius: BorderRadius.circular(4),
+            child: SizedBox(width: size, height: size, child: w));
+  }
+}
+
+/// Builds the combined, Spotify-like library list from the three controllers.
+List<LibEntry> buildLibraryEntries() {
+  final pl = Get.find<LibraryPlaylistsController>();
+  final al = Get.find<LibraryAlbumsController>();
+  final ar = Get.find<LibraryArtistsController>();
+  final out = <LibEntry>[];
+  final playlists = pl.libraryPlaylists.toList();
+  // Liked songs first (like Spotify), then the rest of the playlists.
+  playlists.sort((a, b) {
+    int rank(Playlist p) => p.playlistId == 'LIBSP_liked' ? 0 : 1;
+    return rank(a).compareTo(rank(b));
+  });
+  for (final p in playlists) {
+    final sub = p.playlistId == 'LIBSP_liked'
+        ? 'Playlist • Spotify'
+        : p.description == 'Spotify'
+            ? 'Playlist • Spotify'
+            : 'Playlist';
+    out.add(LibEntry('playlist', p.title, sub, p));
+  }
+  for (final a in al.libraryAlbums) {
+    final artist = (a.artists != null && a.artists!.isNotEmpty)
+        ? '${a.artists![0]['name'] ?? ''}'
+        : '';
+    out.add(LibEntry('album', a.title, 'Album • $artist', a));
+  }
+  for (final a in ar.libraryArtists) {
+    out.add(LibEntry('artist', a.name, 'Artist', a));
+  }
+  return out;
+}
diff --git a/lib/ui/widgets/spotify_web_login.dart b/lib/ui/widgets/spotify_web_login.dart
