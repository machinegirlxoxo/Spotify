+import 'package:flutter/material.dart';
+import 'package:get/get.dart';
+
+import '../screens/Library/library_controller.dart';
+import 'spotify_style.dart';
+
+/// Spotify-style top of the home screen: filter chips and a 2-column
+/// "quick access" grid made from the user's library.
+class SpotifyHomeHeader extends StatelessWidget {
+  const SpotifyHomeHeader({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return Padding(
+      padding: const EdgeInsets.only(right: 16, bottom: 12),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          SingleChildScrollView(
+            scrollDirection: Axis.horizontal,
+            child: Row(children: [
+              const Padding(
+                  padding: EdgeInsets.only(right: 12), child: SpAvatar(size: 36)),
+              const SpChip('All', selected: true),
+              const SpChip('Music'),
+              const SpChip('Podcasts'),
+              const SpChip('Audiobooks'),
+            ]),
+          ),
+          const SizedBox(height: 16),
+          Obx(() {
+            // Rebuild when any library list changes.
+            Get.find<LibraryPlaylistsController>().libraryPlaylists.length;
+            Get.find<LibraryAlbumsController>().libraryAlbums.length;
+            Get.find<LibraryArtistsController>().libraryArtists.length;
+            final entries = buildLibraryEntries()
+                .take(8)
+                .toList();
+            if (entries.isEmpty) return const SizedBox.shrink();
+            return GridView.builder(
+              shrinkWrap: true,
+              physics: const NeverScrollableScrollPhysics(),
+              gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
+                  crossAxisCount: 2,
+                  mainAxisSpacing: 8,
+                  crossAxisSpacing: 8,
+                  mainAxisExtent: 56),
+              itemCount: entries.length,
+              itemBuilder: (context, i) {
+                final e = entries[i];
+                return InkWell(
+                  onTap: e.open,
+                  child: Container(
+                    decoration: BoxDecoration(
+                        color: spSurface,
+                        borderRadius: BorderRadius.circular(6)),
+                    clipBehavior: Clip.antiAlias,
+                    child: Row(children: [
+                      e.thumb(56),
+                      const SizedBox(width: 10),
+                      Expanded(
+                        child: Text(e.title,
+                            maxLines: 2,
+                            overflow: TextOverflow.ellipsis,
+                            style: const TextStyle(
+                                fontSize: 13, fontWeight: FontWeight.w700)),
+                      ),
+                      const SizedBox(width: 6),
+                    ]),
+                  ),
+                );
+              },
+            );
+          }),
+        ],
+      ),
+    );
+  }
+}
+
+/// Home shelves built only from the imported Spotify library
+/// (playlists, albums, artists). Nothing here comes from YouTube Music's home
+/// feed any more.
+class SpotifyHomeShelves extends StatelessWidget {
+  const SpotifyHomeShelves({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return Obx(() {
+      final pl = Get.find<LibraryPlaylistsController>().libraryPlaylists.toList();
+      final al = Get.find<LibraryAlbumsController>().libraryAlbums.toList();
+      final ar = Get.find<LibraryArtistsController>().libraryArtists.toList();
+      final entries = buildLibraryEntries();
+      if (entries.isEmpty) {
+        return Padding(
+          padding: const EdgeInsets.only(top: 60, right: 16),
+          child: Column(
+            children: [
+              const Icon(Icons.library_music_rounded, size: 56, color: spGrey),
+              const SizedBox(height: 14),
+              const Text('Your Spotify library is empty',
+                  style: TextStyle(fontSize: 18, fontWeight: FontWeight.w700)),
+              const SizedBox(height: 6),
+              const Text(
+                  'Log in to Spotify and import your library from your profile (top-left picture) to fill your home.',
+                  textAlign: TextAlign.center,
+                  style: TextStyle(color: spGrey)),
+            ],
+          ),
+        );
+      }
+      final playlists = entries.where((e) => e.kind == 'playlist').toList();
+      final albums = entries.where((e) => e.kind == 'album').toList();
+      final artists = entries.where((e) => e.kind == 'artist').toList();
+      // keep the observables above "used" so Obx subscribes to them
+      assert(pl.length >= 0 && al.length >= 0 && ar.length >= 0);
+      return Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          _shelf('Your playlists', playlists),
+          _shelf('Your albums', albums),
+          _shelf('Your artists', artists, round: true),
+        ],
+      );
+    });
+  }
+
+  Widget _shelf(String title, List<LibEntry> items, {bool round = false}) {
+    if (items.isEmpty) return const SizedBox.shrink();
+    return Padding(
+      padding: const EdgeInsets.only(top: 22),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(title,
+              style:
+                  const TextStyle(fontSize: 22, fontWeight: FontWeight.w800)),
+          const SizedBox(height: 12),
+          SizedBox(
+            height: 190,
+            child: ListView.separated(
+              scrollDirection: Axis.horizontal,
+              itemCount: items.length,
+              separatorBuilder: (_, __) => const SizedBox(width: 14),
+              itemBuilder: (context, i) {
+                final e = items[i];
+                return GestureDetector(
+                  onTap: e.open,
+                  child: SizedBox(
+                    width: 140,
+                    child: Column(
+                      crossAxisAlignment: round
+                          ? CrossAxisAlignment.center
+                          : CrossAxisAlignment.start,
+                      children: [
+                        e.thumb(140),
+                        const SizedBox(height: 8),
+                        Text(e.title,
+                            maxLines: 1,
+                            overflow: TextOverflow.ellipsis,
+                            textAlign: round ? TextAlign.center : TextAlign.start,
+                            style: const TextStyle(
+                                fontSize: 14, fontWeight: FontWeight.w700)),
+                        Text(e.subtitle,
+                            maxLines: 1,
+                            overflow: TextOverflow.ellipsis,
+                            style: const TextStyle(fontSize: 12, color: spGrey)),
+                      ],
+                    ),
+                  ),
+                );
+              },
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
