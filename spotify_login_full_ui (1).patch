+
+/// "Lyrics preview" card shown under the player controls: the first few real
+/// lyric lines of the current song + a "Show lyrics" button that opens the
+/// full synced lyrics page.
+class LyricsPreviewCard extends StatefulWidget {
+  const LyricsPreviewCard({super.key});
+
+  @override
+  State<LyricsPreviewCard> createState() => _LyricsPreviewCardState();
+}
+
+class _LyricsPreviewCardState extends State<LyricsPreviewCard> {
+  final pc = Get.find<PlayerController>();
+  final List<Worker> _workers = [];
+
+  @override
+  void initState() {
+    super.initState();
+    pc.fetchLyrics();
+    // lyrics get reset (emptied) when the song changes -> fetch again
+    _workers.add(ever(pc.lyrics, (_) => pc.fetchLyrics()));
+    _workers.add(ever(pc.currentSong, (_) => pc.fetchLyrics()));
+  }
+
+  @override
+  void dispose() {
+    for (final w in _workers) {
+      w.dispose();
+    }
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Obx(() {
+      final loading = pc.isLyricsLoading.value;
+      final lines = linesFromLyricsMap(pc.lyrics).take(5).toList();
+      if (lines.isEmpty && !loading) return const SizedBox.shrink();
+      final tint = spThemeTint(lightness: 0.3);
+      return GestureDetector(
+        onTap: () => SpotifyLyricsScreen.open(context),
+        child: Container(
+          width: double.infinity,
+          margin: const EdgeInsets.fromLTRB(14, 6, 14, 14),
+          padding: const EdgeInsets.fromLTRB(22, 20, 22, 22),
+          decoration: BoxDecoration(
+              color: tint, borderRadius: BorderRadius.circular(14)),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              const Text('Lyrics preview',
+                  style: TextStyle(
+                      fontSize: 17,
+                      fontWeight: FontWeight.w700,
+                      color: Colors.white)),
+              const SizedBox(height: 22),
+              if (lines.isEmpty)
+                const Text('Loading lyrics…',
+                    style: TextStyle(fontSize: 18, color: Colors.white70))
+              else
+                for (final l in lines)
+                  Padding(
+                    padding: const EdgeInsets.only(bottom: 14),
+                    child: Text(l.text,
+                        style: const TextStyle(
+                            fontSize: 24,
+                            height: 1.15,
+                            fontWeight: FontWeight.w800,
+                            color: Colors.white)),
+                  ),
+              const SizedBox(height: 10),
+              if (lines.isNotEmpty)
+                ElevatedButton(
+                  onPressed: () => SpotifyLyricsScreen.open(context),
+                  style: ElevatedButton.styleFrom(
+                      backgroundColor: Colors.white,
+                      foregroundColor: Colors.black,
+                      elevation: 0,
+                      padding: const EdgeInsets.symmetric(
+                          horizontal: 22, vertical: 12),
+                      shape: const StadiumBorder()),
+                  child: const Text('Show lyrics',
+                      style:
+                          TextStyle(fontSize: 16, fontWeight: FontWeight.w700)),
+                ),
+            ],
+          ),
+        ),
+      );
+    });
+  }
+}
+
+/// "About the artist" card: artist photo, name, subscribers and bio of the
+/// current song's main artist. Tapping it opens the artist page.
+class ArtistPreviewCard extends StatefulWidget {
+  const ArtistPreviewCard({super.key});
+
+  @override
+  State<ArtistPreviewCard> createState() => _ArtistPreviewCardState();
+}
+
+class _ArtistPreviewCardState extends State<ArtistPreviewCard> {
+  static final Map<String, Map<String, dynamic>> _cache = {};
+  final pc = Get.find<PlayerController>();
+  Worker? _worker;
+  String? _artistId;
+  Map<String, dynamic>? _data;
+
+  @override
+  void initState() {
+    super.initState();
+    _load();
+    _worker = ever(pc.currentSong, (_) => _load());
+  }
+
+  @override
+  void dispose() {
+    _worker?.dispose();
+    super.dispose();
+  }
+
+  String? _idOfCurrent() {
+    final artists = pc.currentSong.value?.extras?['artists'];
+    if (artists is List) {
+      for (final a in artists) {
+        if (a is Map && a['id'] != null) return '${a['id']}';
+      }
+    }
+    return null;
+  }
+
+  Future<void> _load() async {
+    final id = _idOfCurrent();
+    if (id == _artistId && _data != null) return;
+    _artistId = id;
+    if (id == null) {
+      if (mounted) setState(() => _data = null);
+      return;
+    }
+    final cached = _cache[id];
+    if (cached != null) {
+      if (mounted) setState(() => _data = cached);
+      return;
+    }
+    if (mounted) setState(() => _data = null);
+    try {
+      final d = await Get.find<MusicServices>().getArtist(id);
+      _cache[id] = d;
+      if (mounted && _artistId == id) setState(() => _data = d);
+    } catch (_) {}
+  }
+
+  void _openArtist() {
+    final id = _artistId;
+    if (id == null) return;
+    pc.playerPanelController.close();
+    Get.toNamed(ScreenNavigationSetup.artistScreen,
+        id: ScreenNavigationSetup.id,
+        preventDuplicates: true,
+        arguments: [true, id]);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    // rebuild if the song (and so the artist) changes
+    return Obx(() {
+      pc.currentSong.value;
+      final d = _data;
+      if (_artistId == null || d == null) return const SizedBox.shrink();
+      final thumbs = d['thumbnails'];
+      String? img;
+      if (thumbs is List && thumbs.isNotEmpty) {
+        img = '${thumbs.last['url']}';
+      }
+      final subs = d['subscribers'];
+      final desc = '${d['description'] ?? ''}'.trim();
+      return GestureDetector(
+        onTap: _openArtist,
+        child: Container(
+          margin: const EdgeInsets.fromLTRB(14, 0, 14, 14),
+          decoration: BoxDecoration(
+              color: spSurface, borderRadius: BorderRadius.circular(14)),
+          clipBehavior: Clip.antiAlias,
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              SizedBox(
+                height: 300,
+                width: double.infinity,
+                child: Stack(
+                  fit: StackFit.expand,
+                  children: [
+                    if (img != null)
+                      CachedNetworkImage(
+                          imageUrl: img,
+                          fit: BoxFit.cover,
+                          errorWidget: (_, __, ___) =>
+                              const ColoredBox(color: spSurface))
+                    else
+                      const ColoredBox(color: spSurface),
+                    const DecoratedBox(
+                      decoration: BoxDecoration(
+                        gradient: LinearGradient(
+                          begin: Alignment.topCenter,
+                          end: Alignment.bottomCenter,
+                          colors: [Color(0x99000000), Color(0x00000000)],
+                          stops: [0, 0.4],
+                        ),
+                      ),
+                    ),
+                    const Positioned(
+                      left: 20,
+                      top: 18,
+                      child: Text('About the artist',
+                          style: TextStyle(
+                              fontSize: 18,
+                              fontWeight: FontWeight.w700,
+                              color: Colors.white)),
+                    ),
+                  ],
+                ),
+              ),
+              Padding(
+                padding: const EdgeInsets.fromLTRB(20, 18, 20, 20),
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Row(
+                      children: [
+                        Expanded(
+                          child: Text('${d['name'] ?? ''}',
+                              maxLines: 1,
+                              overflow: TextOverflow.ellipsis,
+                              style: const TextStyle(
+                                  fontSize: 24,
+                                  fontWeight: FontWeight.w800,
+                                  color: Colors.white)),
+                        ),
+                        const Icon(Icons.chevron_right_rounded,
+                            color: spGrey, size: 28),
+                      ],
+                    ),
+                    if (subs != null)
+                      Padding(
+                        padding: const EdgeInsets.only(top: 4),
+                        child: Text('$subs subscribers',
+                            style:
+                                const TextStyle(fontSize: 15, color: spGrey)),
+                      ),
+                    if (desc.isNotEmpty)
+                      Padding(
+                        padding: const EdgeInsets.only(top: 14),
+                        child: Text(desc,
+                            maxLines: 4,
+                            overflow: TextOverflow.ellipsis,
+                            style: const TextStyle(
+                                fontSize: 15, height: 1.3, color: spGrey)),
+                      ),
+                  ],
+                ),
+              ),
+            ],
+          ),
+        ),
+      );
+    });
+  }
+}
diff --git a/lib/ui/player/components/spotify_lyrics_screen.dart b/lib/ui/player/components/spotify_lyrics_screen.dart
new file mode 100644
index 0000000..2897d9b
--- /dev/null
+++ b/lib/ui/player/components/spotify_lyrics_screen.dart
@@ -0,0 +1,284 @@
+import 'package:audio_video_progress_bar/audio_video_progress_bar.dart';
+import 'package:flutter/material.dart';
+import 'package:get/get.dart';
+import 'package:share_plus/share_plus.dart';
+
+import '../../widgets/loader.dart';
+import '../../widgets/songinfo_bottom_sheet.dart';
+import '../../widgets/spotify_style.dart';
+import '../player_controller.dart';
+import 'animated_play_button.dart';
+import 'lyric_lines.dart';
+
+/// Full-screen, time-synced lyrics page (like Spotify's): big left-aligned
+/// lines, the current line highlighted, tap a line to seek to it.
+class SpotifyLyricsScreen extends StatefulWidget {
+  const SpotifyLyricsScreen({super.key});
+
+  static Future<void> open(BuildContext context) {
+    return Navigator.of(context, rootNavigator: true).push(
+      PageRouteBuilder(
+        opaque: true,
+        transitionDuration: const Duration(milliseconds: 250),
+        pageBuilder: (_, __, ___) => const SpotifyLyricsScreen(),
+        transitionsBuilder: (_, anim, __, child) => SlideTransition(
+          position: Tween(begin: const Offset(0, 1), end: Offset.zero)
+              .animate(CurvedAnimation(parent: anim, curve: Curves.easeOut)),
+          child: child,
+        ),
+      ),
+    );
+  }
+
+  @override
+  State<SpotifyLyricsScreen> createState() => _SpotifyLyricsScreenState();
+}
+
+class _SpotifyLyricsScreenState extends State<SpotifyLyricsScreen> {
+  final pc = Get.find<PlayerController>();
+  final _scroll = ScrollController();
+  final List<GlobalKey> _keys = [];
+  final List<Worker> _workers = [];
+  List<LyricLine> _lines = const [];
+  int _active = -1;
+
+  @override
+  void initState() {
+    super.initState();
+    _rebuildLines();
+    pc.fetchLyrics();
+    _workers.add(ever(pc.lyrics, (_) {
+      _rebuildLines();
+      if (mounted) setState(() {});
+    }));
+    _workers.add(ever(pc.currentSong, (_) => pc.fetchLyrics()));
+    _workers.add(ever(pc.progressBarStatus, (s) {
+      if (_lines.isEmpty || _lines.first.ms < 0) return;
+      final i = activeLyricIndex(_lines, s.current.inMilliseconds);
+      if (i != _active) {
+        if (mounted) setState(() => _active = i);
+        _scrollToActive();
+      }
+    }));
+  }
+
+  void _rebuildLines() {
+    _lines = linesFromLyricsMap(pc.lyrics);
+    _keys
+      ..clear()
+      ..addAll(List.generate(_lines.length, (_) => GlobalKey()));
+    _active = _lines.isEmpty || _lines.first.ms < 0
+        ? -1
+        : activeLyricIndex(
+            _lines, pc.progressBarStatus.value.current.inMilliseconds);
+    WidgetsBinding.instance.addPostFrameCallback((_) => _scrollToActive(jump: true));
+  }
+
+  void _scrollToActive({bool jump = false}) {
+    if (_active < 0 || _active >= _keys.length) return;
+    final ctx = _keys[_active].currentContext;
+    if (ctx == null) return;
+    Scrollable.ensureVisible(ctx,
+        alignment: 0.3,
+        duration: jump ? Duration.zero : const Duration(milliseconds: 350),
+        curve: Curves.easeOut);
+  }
+
+  @override
+  void dispose() {
+    for (final w in _workers) {
+      w.dispose();
+    }
+    _scroll.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final top = MediaQuery.of(context).padding.top;
+    final bottom = MediaQuery.of(context).padding.bottom;
+    return Scaffold(
+      backgroundColor: spBg,
+      body: Obx(() {
+        final tint = spThemeTint(lightness: 0.3);
+        return Container(
+          decoration: BoxDecoration(
+            gradient: LinearGradient(
+              begin: Alignment.topCenter,
+              end: Alignment.bottomCenter,
+              colors: [tint, spTint(tint, lightness: 0.2)],
+            ),
+          ),
+          child: Column(
+            children: [
+              SizedBox(height: top + 8),
+              _header(context),
+              Expanded(child: _body()),
+              _footer(context, bottom),
+            ],
+          ),
+        );
+      }),
+    );
+  }
+
+  Widget _header(BuildContext context) {
+    return Padding(
+      padding: const EdgeInsets.symmetric(horizontal: 8),
+      child: Row(
+        children: [
+          IconButton(
+              iconSize: 34,
+              onPressed: () => Navigator.of(context).pop(),
+              icon: const Icon(Icons.keyboard_arrow_down_rounded)),
+          Expanded(
+            child: Obx(() {
+              final song = pc.currentSong.value;
+              return Column(
+                children: [
+                  Text(song?.title ?? '',
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: const TextStyle(
+                          fontSize: 17,
+                          fontWeight: FontWeight.w700,
+                          color: Colors.white)),
+                  Text(song?.artist ?? '',
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: const TextStyle(fontSize: 15, color: Colors.white)),
+                ],
+              );
+            }),
+          ),
+          const SizedBox(width: 50),
+        ],
+      ),
+    );
+  }
+
+  Widget _body() {
+    return Obx(() {
+      if (pc.isLyricsLoading.value && _lines.isEmpty) {
+        return const Center(child: LoadingIndicator());
+      }
+      if (_lines.isEmpty) {
+        return const Center(
+            child: Text('Lyrics not available for this song',
+                style: TextStyle(
+                    fontSize: 18,
+                    fontWeight: FontWeight.w700,
+                    color: Colors.white70)));
+      }
+      final synced = _lines.first.ms >= 0;
+      return SingleChildScrollView(
+        controller: _scroll,
+        physics: const BouncingScrollPhysics(),
+        padding: const EdgeInsets.fromLTRB(22, 28, 22, 140),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            for (var i = 0; i < _lines.length; i++)
+              GestureDetector(
+                key: _keys[i],
+                behavior: HitTestBehavior.opaque,
+                onTap: synced
+                    ? () => pc.seek(Duration(milliseconds: _lines[i].ms))
+                    : null,
+                child: Padding(
+                  padding: const EdgeInsets.symmetric(vertical: 11),
+                  child: AnimatedDefaultTextStyle(
+                    duration: const Duration(milliseconds: 250),
+                    style: TextStyle(
+                      fontSize: 27,
+                      height: 1.2,
+                      fontWeight: FontWeight.w800,
+                      color: !synced || i == _active
+                          ? Colors.white
+                          : i < _active
+                              ? Colors.white.withOpacity(0.55)
+                              : Colors.white.withOpacity(0.38),
+                    ),
+                    child: Text(_lines[i].text),
+                  ),
+                ),
+              ),
+          ],
+        ),
+      );
+    });
+  }
+
+  Widget _footer(BuildContext context, double bottom) {
+    return Container(
+      padding: EdgeInsets.fromLTRB(20, 8, 20, bottom + 14),
+      decoration: BoxDecoration(
+        gradient: LinearGradient(
+          begin: Alignment.topCenter,
+          end: Alignment.bottomCenter,
+          colors: [Colors.transparent, Colors.black.withOpacity(0.35)],
+        ),
+      ),
+      child: Column(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          Row(
+            mainAxisAlignment: MainAxisAlignment.spaceBetween,
+            children: [
+              IconButton(
+                  onPressed: () {
+                    final song = pc.currentSong.value;
+                    if (song != null) {
+                      Share.share('https://music.youtube.com/watch?v=${song.id}');
+                    }
+                  },
+                  icon: const Icon(Icons.share_outlined)),
+              IconButton(
+                  onPressed: () {
+                    final song = pc.currentSong.value;
+                    if (song == null) return;
+                    showModalBottomSheet(
+                      constraints: const BoxConstraints(maxWidth: 500),
+                      shape: const RoundedRectangleBorder(
+                          borderRadius:
+                              BorderRadius.vertical(top: Radius.circular(10))),
+                      isScrollControlled: true,
+                      context: context,
+                      barrierColor: Colors.transparent.withAlpha(100),
+                      builder: (context) =>
+                          SongInfoBottomSheet(song, calledFromPlayer: true),
+                    ).whenComplete(() => Get.delete<SongInfoController>());
+                  },
+                  icon: const Icon(Icons.more_vert)),
+            ],
+          ),
+          GetX<PlayerController>(builder: (c) {
+            return ProgressBar(
+              timeLabelLocation: TimeLabelLocation.below,
+              thumbRadius: 6,
+              barHeight: 4,
+              thumbGlowRadius: 14,
+              baseBarColor: Colors.white24,
+              bufferedBarColor: Colors.white24,
+              progressBarColor: Colors.white,
+              thumbColor: Colors.white,
+              timeLabelPadding: 4,
+              timeLabelTextStyle: const TextStyle(fontSize: 13, color: spGrey),
+              progress: c.progressBarStatus.value.current,
+              total: c.progressBarStatus.value.total,
+              buffered: c.progressBarStatus.value.buffered,
+              onSeek: c.seek,
+            );
+          }),
+          const SizedBox(height: 6),
+          const CircleAvatar(
+              radius: 36,
+              backgroundColor: Colors.white,
+              child: IconTheme(
+                  data: IconThemeData(color: Colors.black),
+                  child: AnimatedPlayButton(iconSize: 42))),
+        ],
+      ),
+    );
+  }
+}
