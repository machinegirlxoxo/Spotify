+  /// Spotify link for [song]. Songs imported from a Spotify library keep the
+  /// match Spotify id -> YouTube id in the `SpotifyMatches` box, so the
+  /// original track link can be recovered; otherwise open a Spotify search.
+  Future<String> _spotifyLink(MediaItem song) async {
+    try {
+      final box = await Hive.openBox('SpotifyMatches');
+      {
+        for (final key in box.keys) {
+          final v = box.get(key);
+          if (v is Map && '${v['videoId'] ?? v['id']}' == song.id) {
+            return "https://open.spotify.com/track/$key";
+          }
+        }
+      }
+    } catch (_) {}
+    final q = Uri.encodeComponent("${song.title} ${song.artist ?? ''}".trim());
+    return "https://open.spotify.com/search/$q";
+  }
