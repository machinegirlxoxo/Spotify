diff --git a/lib/ui/player/album_color.dart b/lib/ui/player/album_color.dart
new file mode 100644
index 0000000..b0cf891
--- /dev/null
+++ b/lib/ui/player/album_color.dart
@@ -0,0 +1,51 @@
+import 'dart:io';
+
+import 'package:audio_service/audio_service.dart';
+import 'package:cached_network_image/cached_network_image.dart';
+import 'package:flutter/material.dart';
+import 'package:get/get.dart';
+import 'package:palette_generator/palette_generator.dart';
+
+/// Extracts the dominant colour of the current song's cover so the player
+/// gradient, mini player and lyrics card follow the album art.
+///
+/// This works in every theme mode (the old code only did it for the
+/// "dynamic" theme and only inside the gesture player).
+class AlbumColor extends GetxController {
+  final color = Rxn<Color>();
+  final _cache = <String, Color>{};
+  String? _currentId;
+
+  static AlbumColor get instance => Get.isRegistered<AlbumColor>()
+      ? Get.find<AlbumColor>()
+      : Get.put(AlbumColor(), permanent: true);
+
+  Future<void> update(MediaItem? song) async {
+    if (song == null) return;
+    _currentId = song.id;
+    final cached = _cache[song.id];
+    if (cached != null) {
+      color.value = cached;
+      return;
+    }
+    try {
+      final uri = song.artUri;
+      if (uri == null) return;
+      final ImageProvider<Object> provider = uri.isScheme('file')
+          ? FileImage(File(uri.toFilePath()))
+          : CachedNetworkImageProvider(uri.toString());
+      final generator = await PaletteGenerator.fromImageProvider(
+          ResizeImage(provider, width: 120, height: 120),
+          maximumColorCount: 12);
+      final picked = generator.vibrantColor ??
+          generator.dominantColor ??
+          generator.darkVibrantColor ??
+          generator.mutedColor ??
+          generator.darkMutedColor;
+      if (picked == null) return;
+      _cache[song.id] = picked.color;
+      // Ignore stale results when the song changed while we were decoding.
+      if (_currentId == song.id) color.value = picked.color;
+    } catch (_) {}
+  }
+}
diff --git a/lib/ui/player/components/lyric_lines.dart b/lib/ui/player/components/lyric_lines.dart
new file mode 100644
index 0000000..9933af0
--- /dev/null
+++ b/lib/ui/player/components/lyric_lines.dart
@@ -0,0 +1,71 @@
+/// One line of (optionally timed) lyrics.
+class LyricLine {
+  const LyricLine(this.ms, this.text);
+
+  /// Start time in milliseconds, or -1 for plain (un-synced) lyrics.
+  final int ms;
+  final String text;
+}
+
+final _stamp = RegExp(r'\[(\d{1,3}):(\d{2})(?:[.:](\d{1,3}))?\]');
+
+/// Parses an LRC string ("[01:23.45] text") into timed lines.
+List<LyricLine> parseSyncedLyrics(String lrc) {
+  final out = <LyricLine>[];
+  for (final raw in lrc.split('\n')) {
+    final matches = _stamp.allMatches(raw).toList();
+    if (matches.isEmpty) continue;
+    final text = raw.substring(matches.last.end).trim();
+    if (text.isEmpty) continue;
+    for (final m in matches) {
+      final min = int.parse(m.group(1)!);
+      final sec = int.parse(m.group(2)!);
+      var frac = 0;
+      final f = m.group(3);
+      if (f != null) {
+        frac = f.length == 1
+            ? int.parse(f) * 100
+            : f.length == 2
+                ? int.parse(f) * 10
+                : int.parse(f);
+      }
+      out.add(LyricLine((min * 60 + sec) * 1000 + frac, text));
+    }
+  }
+  out.sort((a, b) => a.ms.compareTo(b.ms));
+  return out;
+}
+
+/// Plain lyrics -> one [LyricLine] per non-empty line (ms = -1).
+List<LyricLine> parsePlainLyrics(String text) => text
+    .split('\n')
+    .map((l) => l.trim())
+    .where((l) => l.isNotEmpty)
+    .map((l) => LyricLine(-1, l))
+    .toList();
+
+/// Picks synced lyrics when present, otherwise plain ones. Returns an empty
+/// list when nothing usable is available ("NA" / empty).
+List<LyricLine> linesFromLyricsMap(Map lyrics) {
+  final synced = '${lyrics['synced'] ?? ''}';
+  if (synced.trim().isNotEmpty) {
+    final lines = parseSyncedLyrics(synced);
+    if (lines.isNotEmpty) return lines;
+  }
+  final plain = '${lyrics['plainLyrics'] ?? ''}';
+  if (plain.trim().isEmpty || plain.trim() == 'NA') return const [];
+  return parsePlainLyrics(plain);
+}
+
+/// Index of the line being sung at [positionMs], or -1 before the first line.
+int activeLyricIndex(List<LyricLine> lines, int positionMs) {
+  var idx = -1;
+  for (var i = 0; i < lines.length; i++) {
+    if (lines[i].ms <= positionMs) {
+      idx = i;
+    } else {
+      break;
+    }
+  }
+  return idx;
+}
