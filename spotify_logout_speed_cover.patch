+/// Minimal counting semaphore used to cap concurrent network work.
+class _Pool {
+  _Pool(this._free);
+  int _free;
+  final _waiting = <Completer<void>>[];
+
+  Future<T> run<T>(Future<T> Function() task) async {
+    if (_free > 0) {
+      _free--;
+    } else {
+      final c = Completer<void>();
+      _waiting.add(c);
+      await c.future;
+    }
+    try {
+      return await task();
+    } finally {
+      if (_waiting.isNotEmpty) {
+        _waiting.removeAt(0).complete();
+      } else {
+        _free++;
+      }
+    }
+  }
+}
+
+/// Serialises async sections (used for Hive box open/write/close).
+class _Lock {
+  Future<void> _last = Future.value();
+  Future<T> synchronized<T>(Future<T> Function() task) {
+    final next = _last.then((_) => task());
+    _last = next.then((_) {}, onError: (_) {});
+    return next;
+  }
+}
